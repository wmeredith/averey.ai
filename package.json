{
  "name": "averey",
  "version": "0.1.0",
  "description": "Averey.ai: an average intelligence harness. Wraps any LLM with a simulated average human worker (fatigue, moods, breaks, sick days, lossy memory).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/cli",
    "README.md"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "simulate": "npm run -s build && node dist/cli/simulate.js",
    "hello": "npm run -s build && node --env-file=.env dist/cli/hello.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
